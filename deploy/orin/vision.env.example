# /etc/label-lens-vision/vision.env — read by label-lens-vision.service.
# Bind to the Orin's LAN (or Tailscale) address, never 0.0.0.0 on an untrusted network.
VISION_BIND_HOST=192.168.1.50
VISION_PORT=8080

# Paths printed by fetch-model.sh.
VISION_MODEL_PATH=/opt/label-lens-vision/models/REPLACE/model.gguf
VISION_MMPROJ_PATH=/opt/label-lens-vision/models/REPLACE/mmproj.gguf

# The name clients send as `model` and Label Lens records in provenance.
# Make it specific: family, size, quantization.
VISION_MODEL_ALIAS=qwen2.5-vl-7b-instruct-q8_0

# Context must hold one image plus a short transcription. 8192 is ample for
# region crops; raise it if whole-label evaluation reports truncation.
VISION_CTX=8192

# One request at a time keeps latency predictable on a single Orin.
VISION_PARALLEL=1
